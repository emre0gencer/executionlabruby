<% content_for :title, "Executions" %>

<h1>Executions</h1>

<table>
  <thead>
    <tr>
      <th>Program</th>
      <th>Runtime</th>
      <th>Status</th>
      <th>Created</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @executions.each do |execution| %>
      <tr>
        <td><%= execution.program.name %></td>
        <td><%= execution.runtime.name %></td>
        <td><%= execution.status %></td>
        <td><%= l(execution.created_at, format: :short) %></td>
        <td><%= link_to "View", execution_path(execution) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
