<% content_for :title, "Execution — #{@execution.program.name}" %>

<div class="mb-6 flex items-center gap-4">
  <%= link_to "← #{@execution.program.name}", program_path(@execution.program), class: "text-slate-400 hover:text-slate-200 text-sm transition-colors" %>
  <span class="text-slate-600">|</span>
  <%= link_to "All Executions", executions_path, class: "text-slate-400 hover:text-slate-200 text-sm transition-colors" %>
</div>

<%# Status banner %>
<% status_styles = { "completed" => "bg-emerald-900/40 border-emerald-700 text-emerald-300",
                     "failed"    => "bg-red-900/40 border-red-700 text-red-300",
                     "running"   => "bg-yellow-900/40 border-yellow-700 text-yellow-300",
                     "pending"   => "bg-slate-800 border-slate-700 text-slate-400" } %>
<div class="mb-6 flex flex-wrap items-center gap-3">
  <h1 class="text-2xl font-bold text-white"><%= @execution.program.name %></h1>
  <span class="px-2.5 py-1 text-xs font-mono rounded-full border <%= status_styles[@execution.status] || status_styles["pending"] %>">
    <%= @execution.status %>
  </span>
  <span class="text-slate-500 text-sm">on</span>
  <span class="text-slate-300 font-medium"><%= @execution.runtime.name %></span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%# Left: result + trace %>
  <div class="lg:col-span-2 space-y-6">

    <%# Error %>
    <% if @execution.error.present? %>
      <div class="bg-red-900/30 border border-red-700 rounded-xl p-4">
        <h3 class="text-red-300 font-semibold text-sm mb-2">VM Error</h3>
        <p class="font-mono text-sm text-red-200"><%= @execution.error %></p>
      </div>
    <% end %>

    <%# Result %>
    <% if @execution.result.present? %>
      <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-700 flex items-center justify-between">
          <h3 class="text-slate-300 font-semibold text-sm">Result</h3>
        </div>
        <pre class="font-mono text-sm bg-slate-950 text-green-400 p-4 overflow-auto max-h-48"><%= JSON.pretty_generate(@execution.result) %></pre>
      </div>
    <% end %>

    <%# Trace debugger %>
    <% traces = @execution.execution_traces.order(:step).map(&:snapshot) %>
    <% if traces.any? %>
      <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden"
           data-controller="trace-debugger"
           data-trace-debugger-traces-value="<%= traces.to_json.gsub('"', '&quot;') %>">

        <%# Header + nav %>
        <div class="px-4 py-3 border-b border-slate-700 flex items-center justify-between">
          <h3 class="text-slate-300 font-semibold text-sm">Step-through Debugger</h3>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 text-xs" data-trace-debugger-target="stepLabel">Step 1 / <%= traces.length %></span>
            <button data-action="trace-debugger#prev"
                    class="px-2.5 py-1 text-xs bg-slate-700 hover:bg-slate-600 text-slate-300 rounded transition-colors">← Prev</button>
            <button data-action="trace-debugger#next"
                    class="px-2.5 py-1 text-xs bg-slate-700 hover:bg-slate-600 text-slate-300 rounded transition-colors">Next →</button>
          </div>
        </div>

        <%# Current instruction %>
        <div class="px-4 py-3 bg-slate-900/50 border-b border-slate-700 flex items-center gap-4">
          <span class="font-mono text-lg font-bold text-indigo-300" data-trace-debugger-target="opcode">—</span>
          <span class="font-mono text-xs text-slate-500" data-trace-debugger-target="pc"></span>
          <span class="text-slate-600 text-xs ml-auto">← → arrow keys to navigate</span>
        </div>

        <%# VM state panels %>
        <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-slate-700">
          <div class="p-4">
            <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Operand Stack</h4>
            <div class="font-mono text-sm space-y-0.5 min-h-12" data-trace-debugger-target="stack"></div>
          </div>
          <div class="p-4">
            <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Local Variables</h4>
            <div class="font-mono text-sm space-y-0.5 min-h-12" data-trace-debugger-target="locals"></div>
          </div>
          <div class="p-4">
            <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Call Stack</h4>
            <div class="font-mono text-sm space-y-0.5 min-h-12" data-trace-debugger-target="callStack"></div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="bg-slate-800/50 border border-slate-700 border-dashed rounded-xl p-6 text-center">
        <p class="text-slate-500 text-sm">No trace recorded.</p>
        <%= link_to "Re-run with trace", new_execution_path(program_id: @execution.program_id),
              class: "text-indigo-400 hover:text-indigo-300 text-sm underline" %>
      </div>
    <% end %>
  </div>

  <%# Right: metrics sidebar %>
  <div class="space-y-4">
    <% if @execution.metrics.present? %>
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 space-y-4">
        <h3 class="text-slate-300 font-semibold text-sm uppercase tracking-wider">Metrics</h3>
        <% @execution.metrics.each do |key, val| %>
          <div class="flex justify-between items-baseline">
            <span class="text-slate-400 text-sm"><%= key.to_s.humanize %></span>
            <span class="font-mono text-white font-medium"><%= val %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 space-y-3">
      <h3 class="text-slate-300 font-semibold text-sm uppercase tracking-wider">Actions</h3>
      <%= link_to new_execution_path(program_id: @execution.program_id),
            class: "flex items-center justify-center gap-2 w-full px-3 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition-colors" do %>
        ▶ Run Again
      <% end %>
      <%= link_to compare_program_path(@execution.program),
            class: "flex items-center justify-center gap-2 w-full px-3 py-2.5 bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm font-medium rounded-lg transition-colors" do %>
        ∥ Compare Runtimes
      <% end %>
    </div>

    <div class="text-xs text-slate-600 px-1">
      Executed <%= time_ago_in_words(@execution.created_at) %> ago
    </div>
  </div>
</div>
