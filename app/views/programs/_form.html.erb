<%= form_with(model: program, class: "space-y-6") do |form| %>
  <% if program.errors.any? %>
    <div class="px-4 py-3 rounded-lg bg-red-900/60 border border-red-700 text-red-200">
      <h2 class="font-semibold mb-2"><%= pluralize(program.errors.count, "error") %> prevented this program from being saved:</h2>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <% program.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-1">
    <%= form.label :name, class: "block text-sm font-medium text-slate-300" %>
    <%= form.text_field :name, class: "w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div class="space-y-1">
    <%= form.label :description, class: "block text-sm font-medium text-slate-300" %>
    <%= form.textarea :description, rows: 3, class: "w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div class="space-y-1">
    <%= form.label :instruction_set, class: "block text-sm font-medium text-slate-300" %>
    <%= form.text_field :instruction_set, value: program.instruction_set.presence || "c0-vm",
          class: "w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white font-mono placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div class="space-y-1">
    <%= form.label :assembly_source, "Assembly Source (optional)", class: "block text-sm font-medium text-slate-300" %>
    <%= form.text_area :assembly_source, value: program.assembly_source, rows: 10,
          placeholder: "FUNC main 0 0\nBIPUSH 1\nRETURN\nEND",
          class: "w-full px-3 py-2 bg-slate-950 border border-slate-600 rounded-lg text-green-400 font-mono text-sm placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
    <p class="text-xs text-slate-500">If provided, assembly will be parsed into bytecode and override the JSON below.</p>
  </div>

  <div class="space-y-1">
    <%= form.label :bytecode, "Bytecode JSON", class: "block text-sm font-medium text-slate-300" %>
    <%= form.text_area :bytecode, value: program.bytecode.to_json, rows: 10,
          class: "w-full px-3 py-2 bg-slate-950 border border-slate-600 rounded-lg text-green-400 font-mono text-sm placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= form.submit class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-lg transition-colors cursor-pointer" %>
  </div>
<% end %>
