<div id="<%= dom_id program %>" class="bg-slate-800 border border-slate-700 rounded-xl p-5 flex flex-col gap-4 hover:border-slate-600 transition-colors">
  <div class="flex items-start justify-between gap-2">
    <h2 class="text-white font-semibold text-lg leading-tight"><%= program.name %></h2>
    <span class="shrink-0 px-2 py-0.5 text-xs font-mono rounded-full bg-indigo-900/60 text-indigo-300 border border-indigo-800">
      <%= program.instruction_set %>
    </span>
  </div>

  <% if program.description.present? %>
    <p class="text-slate-400 text-sm line-clamp-2"><%= program.description %></p>
  <% end %>

  <div class="flex items-center gap-2 mt-auto pt-2 border-t border-slate-700">
    <%= link_to "View", program, class: "flex-1 text-center px-3 py-1.5 text-sm text-slate-300 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors" %>
    <%= link_to "Run ▶", new_execution_path(program_id: program.id), class: "flex-1 text-center px-3 py-1.5 text-sm text-white bg-indigo-700 hover:bg-indigo-600 rounded-lg transition-colors" %>
    <%= link_to "Compare ∥", compare_program_path(program), class: "flex-1 text-center px-3 py-1.5 text-sm text-slate-300 bg-slate-700 hover:bg-slate-600 rounded-lg transition-colors" %>
  </div>
</div>
