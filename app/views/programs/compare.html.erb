<% content_for :title, "Compare Runtimes — #{@program.name}" %>

<div class="mb-6">
  <%= link_to "← #{@program.name}", program_path(@program), class: "text-slate-400 hover:text-slate-200 text-sm transition-colors" %>
</div>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-white">Runtime Comparison</h1>
    <p class="text-slate-400 text-sm mt-1"><%= @program.name %></p>
  </div>
</div>

<% if @executions.empty? %>
  <div class="bg-slate-800/50 border border-slate-700 border-dashed rounded-xl p-12 text-center">
    <p class="text-slate-500">No compatible runtimes found for instruction set <code class="text-indigo-400"><%= @program.instruction_set %></code>.</p>
    <%= link_to "Manage Runtimes", runtimes_path, class: "text-indigo-400 hover:text-indigo-300 underline text-sm mt-2 inline-block" %>
  </div>
<% else %>
  <%# Summary cards row %>
  <div class="grid grid-cols-1 sm:grid-cols-<%= [@executions.length, 3].min %> gap-4 mb-8">
    <% @executions.each_with_index do |execution, i| %>
      <% completed = execution.status.to_s == "completed" %>
      <div class="bg-slate-800 border <%= completed ? 'border-slate-700' : 'border-red-800/60' %> rounded-xl p-5">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-white font-semibold"><%= execution.runtime.name %></h3>
          <% if completed %>
            <span class="px-2 py-0.5 text-xs font-mono rounded-full bg-emerald-900/40 text-emerald-300 border border-emerald-800">completed</span>
          <% else %>
            <span class="px-2 py-0.5 text-xs font-mono rounded-full bg-red-900/40 text-red-300 border border-red-800">failed</span>
          <% end %>
        </div>

        <% if execution.error.present? %>
          <p class="text-red-400 text-xs font-mono truncate" title="<%= execution.error %>"><%= execution.error %></p>
        <% elsif execution.metrics.present? %>
          <div class="space-y-1.5">
            <% execution.metrics.each do |key, val| %>
              <div class="flex justify-between items-baseline">
                <span class="text-slate-500 text-xs"><%= key.to_s.humanize %></span>
                <span class="font-mono text-sm text-white font-medium"><%= val %></span>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if execution.persisted? %>
          <div class="mt-3 pt-3 border-t border-slate-700">
            <%= link_to "View →", execution_path(execution), class: "text-indigo-400 hover:text-indigo-300 text-xs transition-colors" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Results comparison table %>
  <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden mb-6">
    <div class="px-4 py-3 border-b border-slate-700">
      <h3 class="text-slate-300 font-semibold text-sm">Results</h3>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-<%= [@executions.length, 3].min %> divide-y sm:divide-y-0 sm:divide-x divide-slate-700">
      <% @executions.each do |execution| %>
        <div class="p-4">
          <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-2"><%= execution.runtime.name %></p>
          <% if execution.error.present? %>
            <p class="font-mono text-xs text-red-400 break-words"><%= execution.error %></p>
          <% elsif execution.result.present? %>
            <pre class="font-mono text-xs text-green-400 overflow-auto max-h-48"><%= JSON.pretty_generate(execution.result) %></pre>
          <% else %>
            <span class="text-slate-600 text-xs italic">no result</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Metrics chart (simple bar visualization) %>
  <% metric_keys = @executions.flat_map { |e| (e.metrics || {}).keys }.uniq %>
  <% if metric_keys.any? %>
    <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-700">
        <h3 class="text-slate-300 font-semibold text-sm">Metrics Comparison</h3>
      </div>
      <div class="p-4 space-y-6">
        <% metric_keys.each do |key| %>
          <div>
            <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-3"><%= key.to_s.humanize %></p>
            <% values = @executions.map { |e| [(e.metrics || {})[key].to_f, 0].max } %>
            <% max_val = values.max.to_f %>
            <div class="space-y-2">
              <% @executions.each_with_index do |execution, i| %>
                <% val = (execution.metrics || {})[key] %>
                <% pct = max_val > 0 ? (val.to_f / max_val * 100).round(1) : 0 %>
                <div class="flex items-center gap-3">
                  <span class="text-slate-400 text-sm w-32 shrink-0 truncate"><%= execution.runtime.name %></span>
                  <div class="flex-1 bg-slate-700/50 rounded-full h-2">
                    <div class="bg-indigo-500 h-2 rounded-full transition-all" style="width: <%= pct %>%"></div>
                  </div>
                  <span class="font-mono text-sm text-white w-20 text-right shrink-0"><%= val || "—" %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
