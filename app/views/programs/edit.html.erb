<% content_for :title, "Edit #{@program.name} — Execution Lab" %>

<div class="mb-6">
  <%= link_to "← #{@program.name}", @program, class: "text-slate-400 hover:text-slate-200 text-sm transition-colors" %>
</div>

<div class="max-w-2xl">
  <h1 class="text-2xl font-bold text-white mb-8">Edit Program</h1>
  <div class="bg-slate-800 border border-slate-700 rounded-xl p-6">
    <%= render "form", program: @program %>
  </div>
</div>
