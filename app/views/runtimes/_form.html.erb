<%= form_with(model: runtime, class: "space-y-5") do |form| %>
  <% if runtime.errors.any? %>
    <div class="bg-red-900/30 border border-red-700 rounded-lg p-4">
      <h3 class="text-red-300 font-semibold text-sm mb-2">
        <%= pluralize(runtime.errors.count, "error") %> prevented saving:
      </h3>
      <ul class="list-disc list-inside space-y-1">
        <% runtime.errors.each do |error| %>
          <li class="text-red-300 text-sm"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
    <%= form.text_field :name,
          class: "w-full bg-slate-800 border border-slate-600 text-white rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :instruction_set, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
    <%= form.text_field :instruction_set,
          value: runtime.instruction_set.presence || "c0-vm",
          class: "w-full bg-slate-800 border border-slate-600 text-white rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :adapter_class, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
    <%= form.text_field :adapter_class,
          value: runtime.adapter_class.presence || "ExecutionLab::Runtimes::RubyC0VM",
          class: "w-full bg-slate-800 border border-slate-600 text-white font-mono text-sm rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :config, "Config (JSON)", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
    <%= form.text_area :config,
          value: runtime.config.to_json,
          rows: 6,
          class: "w-full bg-slate-800 border border-slate-600 text-white font-mono text-sm rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "w-full px-4 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-lg transition-colors cursor-pointer" %>
  </div>
<% end %>
